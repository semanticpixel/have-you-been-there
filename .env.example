# Copy to .env.local for local development. On Vercel, set these under Project → Settings → Environment Variables.
# Every VITE_ value ends up in the browser, so only put browser-safe keys here.

# Supabase: Project Settings → API Keys. Use the *publishable* key (older projects: the "anon public" key).
# NEVER put the secret / service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Google Maps Platform key. Enable "Maps JavaScript API" and "Places API (New)".
# Restrict it to your site's HTTP referrers in the Google Cloud console.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID from the Cloud console (needed for styled Advanced Markers).
# Leave blank to use Google's DEMO_MAP_ID while developing.
VITE_GOOGLE_MAPS_MAP_ID=
